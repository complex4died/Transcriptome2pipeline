# ==========================================
# 1. macOS 系统专属（必加，防止 Finder 污染仓库）
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon\r\r
.AppleDouble
.AppleDB

# ==========================================
# 2. R 语言与 RStudio 相关
# ==========================================
.Rhistory
.RData
.Rdata
.Ruserdata
.Rproj.user/

# ==========================================
# 3. Python 相关（如果有混用）
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
.pytest_cache/

# ==========================================
# 4. 常见代码编辑器（VS Code / JetBrains）
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==========================================
# 5. 生信数据与超大文件（建议按需开启）
# ==========================================
# 建议不要把动辄几百兆的原始数据传到 git
data/raw/*
!data/raw/.gitkeep
results/*
!results/.gitkeep
*.gz
*.tar
*.rds

# ==========================================
# 6. 确定不上传的数据
# ==========================================
datas/*
!datas/.gitkeep

Results/*/*
!Results/**/.gitkeep




